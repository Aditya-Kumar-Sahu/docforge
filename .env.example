# Database configuration
# Note: Local Docker Postgres is mapped to 5433 to avoid conflicts with system Postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/docforge

# Supabase Auth
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Phase 1)
GEMINI_API_KEY=your_gemini_api_key

# Monitoring & Analytics (Final Phase 0 Gate)
SENTRY_DSN=your_sentry_dsn
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://app.posthog.com

# Deployment (Azure)
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
